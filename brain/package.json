{
  "name": "tab-brain",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/hub.ts",
    "dev": "tsx watch src/hub.ts",
    "send": "tsx tools/send.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "memory": "node --no-warnings=ExperimentalWarning --import tsx tools/memory.ts",
    "eval": "node --no-warnings=ExperimentalWarning --import tsx tools/eval.ts",
    "e2e": "node --no-warnings=ExperimentalWarning --import tsx tools/e2e-testbed.ts",
    "e2e:canvas": "node --no-warnings=ExperimentalWarning --import tsx tools/e2e-canvas.ts",
    "e2e:chores": "node --no-warnings=ExperimentalWarning --import tsx tools/e2e-chores.ts"
  },
  "dependencies": {
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "dotenv": "^18.0.7",
    "viem": "^2.57.16",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
