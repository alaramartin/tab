# Tab runs entirely on this Mac. Optional settings:
#   TAB_LLM=off      fast tiers only, no local LLM
#   TAB_MEMORY=off   suggest without saving anything to disk
#   TAB_DEBUG=1      details in the logs (ghost text, typed values, timings)
# Payment rail: mpp (demo, Tempo testnet) or x402 (fallback, Base Sepolia). Restart npm run demo and npm start after a change.
PAY_RAIL=mpp
# mpp: npm run tempo-wallets prints these (faucet-funded pathUSD on Tempo testnet, chain 42431)
MPP_SECRET_KEY=
TEMPO_PAYER_PRIVATE_KEY=
TEMPO_PAYEE_ADDRESS=
TEMPO_ATTACKER_ADDRESS=
# x402: npm run wallets
PAYER_PRIVATE_KEY=
PAYEE_ADDRESS=
ATTACKER_ADDRESS=
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
GITHUB_DEMO_REPO=
HUB_PORT=7800
CDP_PORT=9222
