# Prediction is local (llama.cpp, models in ~/.tab/models). TAB_MODEL: qwen (default) | lfm | qwen4 | empty = no LLM.
TAB_MODEL=
# Opt-in cloud instead of local models: TAB_DECIDER=claude with an Anthropic key.
TAB_DECIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=
# Payment rail: mpp (demo, Tempo testnet) or x402 (fallback, Base Sepolia). Restart npm run demo and npm start after a change.
PAY_RAIL=mpp
# mpp: npm run tempo-wallets prints these (faucet-funded pathUSD on Tempo testnet, chain 42431)
MPP_SECRET_KEY=
TEMPO_PAYER_PRIVATE_KEY=
TEMPO_PAYEE_ADDRESS=
TEMPO_ATTACKER_ADDRESS=
# x402: npm run wallets
PAYER_PRIVATE_KEY=
PAYEE_ADDRESS=
ATTACKER_ADDRESS=
NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
GITHUB_DEMO_REPO=
HUB_PORT=7800
CDP_PORT=9222
